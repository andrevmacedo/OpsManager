# qual arquivo inicializa a aplicação Flask — aponta para a pasta app/
FLASK_APP=app
# modo de execução — development ativa o debug e o recarregamento automático ao salvar
FLASK_ENV=development
# chave secreta usada para proteger sessões e cookies do Flask
# nunca commitar um valor real aqui no GitHub
SECRET_KEY=opsmanager_secret_key
# caminho completo do banco de dados configurado pelo usuário no formulário /configurar
# começa vazio — preenchido automaticamente pelo set_key quando o usuário configurar
DB_PATH=database/opsmanager.db